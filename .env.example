PORT=5000
NODE_ENV=production
FIREBASE_PROJECT_ID=avani-computer-institute-44b7f
FIREBASE_API_KEY=your_firebase_web_api_key
INSTITUTE_SHORT_CODE=ACI
INSTITUTE_NAME=Avani Computer Institute
INTERNAL_EMAIL_DOMAIN=students.avani.internal

# Firebase Service Account (JSON string or base64 string for cloud environments like Render)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# MongoDB Atlas connection string for archival database (supports MONGODB_URI or MONGO_URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/
MONGO_DB_NAME=avani_institute_archive
